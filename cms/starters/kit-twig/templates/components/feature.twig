{# Feature — <Feature icon="⚡" title="Fast" body="No build step." /> #}
<div class="ds-feature">
  <span class="ds-feature__icon" aria-hidden="true">{{ icon|default('✨') }}</span>
  <h3 class="ds-feature__title">{{ title|default('Feature') }}</h3>
  <p class="ds-feature__body">{{ body|default('A short description of this feature.') }}</p>
</div>
