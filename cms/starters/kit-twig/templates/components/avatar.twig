{# Avatar — <Avatar src="/me.jpg" name="Marko Krstic" size="md" />
   props: src, name, size(sm|md|lg). Falls back to initials when no src. #}
{% set size = size|default('md') %}
{% if src|default('') %}
<img class="ds-avatar ds-avatar--{{ size }}" src="{{ src }}" alt="{{ name|default('') }}">
{% else %}
<span class="ds-avatar ds-avatar--{{ size }}" aria-label="{{ name|default('') }}">{{ (name|default('?'))|slice(0, 1) }}</span>
{% endif %}
