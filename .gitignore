# ──────────────────────────────────────────────────────────────────
# Dependencies — regenerated via `composer install` / `npm ci`
# ──────────────────────────────────────────────────────────────────
cms/vendor/
src/node_modules/

# ──────────────────────────────────────────────────────────────────
# Build artifacts — regenerated via `npm run build`
# ──────────────────────────────────────────────────────────────────
public/cms/dist/
src/dist/
**/.vite/
.vite-hot
# Vite's hashed React bundle. CI rebuilds these on every release and
# rsync ships them in the zip, so tracking them in git just bloats
# commit diffs with renamed-asset noise. Developers cloning the repo
# run `cd src && npm run build` once (or `npm run dev` for HMR).
admin/assets/

# ──────────────────────────────────────────────────────────────────
# /site is fully user-owned, never tracked. Defaults (config, content,
# uploads stub, default theme) live under cms/starters/ and are copied
# in on first request by MD\Bootstrap::ensureSiteDefaults(). Editing
# content in the admin no longer creates diffs in the framework repo.
# ──────────────────────────────────────────────────────────────────
site/

# Per-install runtime config. The framework ships `sample.config.php` as
# a template; the live `config.php` is generated/edited locally and
# may contain secrets, so it must never be tracked.
config.php


# Local Sites recreates a MySQL dump at /sql/local.sql for any site it
# manages, regardless of whether the framework uses SQL. mdframework is
# flat-file only — never ship this in a release zip or commit it to git.
sql/

# ──────────────────────────────────────────────────────────────────
# Tool caches & local-only output
# ──────────────────────────────────────────────────────────────────
.phpunit.result.cache
.php-cs-fixer.cache
phpstan-baseline.neon
coverage/
*.log

# ──────────────────────────────────────────────────────────────────
# Editor / IDE
# ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ──────────────────────────────────────────────────────────────────
# OS metadata
# ──────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db

# ──────────────────────────────────────────────────────────────────
# FrontPress Local desktop app — injects this auto-login bridge into
# each local install. Operator/app-owned, never part of the framework.
# ──────────────────────────────────────────────────────────────────
/fp-local-login.php

# ──────────────────────────────────────────────────────────────────
# Release artifacts
# ──────────────────────────────────────────────────────────────────
release/
*.zip
